{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../src/*"],
      "npm:@supabase/supabase-js@2": ["../node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": []
}
